DB_HOST=localhost
DB_USER=your_user_name
DB_PASSWORD=your_password
DB_NAME=your_DB_name
DB_PORT=3306_by_default
PORT=4242
ALLOWED_ORIGIN=http://localhost:5173

# Niveaux Winston : error | warn | info | http | verbose | debug | silly
# Pour du debug : LOG_LEVEL=debug, puis redémarrer le serveur
LOG_LEVEL=info
# En production (NODE_ENV=production) : logs aussi dans logs/app-*.log (rotation 7j / 20m)

# Origine publique du backend (images + CSP Helmet imgSrc/connectSrc) — à adapter en production
IMAGE_BASE_URL=http://localhost:4242

# À lancer DEUX FOIS (un secret par ligne)
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Secret aléatoire ≥ 32 bytes (256 bits), encodé en base64
ACCESS_TOKEN_SECRET=une_longue_chaîne_aléatoire_secrète_1
REFRESH_TOKEN_SECRET=une_autre_longue_chaîne_aléatoire_secrète_2

# Durées de vie des tokens (format jwt, ex. "15m", "1h", "7d")
# Utilisées au login et au refresh ; défauts "15m" / "7d" si absentes
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d